{
  "name": "@splitpool/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "test:backend": "tsx --env-file-if-exists=.env --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^10.1.4",
    "@google/genai": "^2.30.0",
    "@splitpool/contracts": "0.1.0",
    "@supabase/supabase-js": "^2.118.0",
    "fastify": "^5.0.0",
    "pg": "^8.23.1",
    "tsx": "^4.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
