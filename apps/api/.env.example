# Live Gemini receipt parsing (API only — never put this in EXPO_PUBLIC_*).
# File path must be: apps/api/.env  (copy this file)
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
# After changing the key, restart `npm run api` (tsx watch does not reload .env by itself).
# Verify with: curl http://localhost:3001/api/v1/health
#   → geminiKeyPresent: true, receiptParser: "gemini-3.8-flash"
GEMINI_API_KEY=

# Copy to apps/api/.env. Never commit credentials.
PORT=3001
# Tiger Data: use the provider's connection URL and certificate-verifying TLS settings.
# Example (replace all placeholders):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# Shared/free Tiger Data, local development only: encrypted but server identity is not verified.
# NODE_ENV=development
# DATABASE_ALLOW_SELF_SIGNED=true
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Comma-separated browser origins; native clients do not require CORS.
# Non-production also allows http://localhost:<any-port> and 127.0.0.1 for Expo web.
CORS_ORIGINS=http://localhost:8081
# Optional integration tests: dedicated disposable PostgreSQL database only.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/splitpool_test
