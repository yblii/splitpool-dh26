# Optional: the local demo works without any services configured.
# On a physical phone use your computer's LAN IP, not localhost.
# Android emulator: http://10.0.2.2:3001
# Browser: http://localhost:3001
# Required for app profiles / groups (LAN IP on a physical phone).
EXPO_PUBLIC_API_URL=
# From Supabase → Project Settings → API. File must live at apps/mobile/.env (not repo root).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer the publishable/anon key. Either name works:
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Profile photos upload to a public Storage bucket named "avatars".
# After editing .env, stop Metro completely and run npm start again.
